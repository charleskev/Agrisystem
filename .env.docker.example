# Local Docker-only settings. Keep this file separate from the production .env.
DOCKER_FRONTEND_PORT=3001
DOCKER_BACKEND_PORT=5001
DOCKER_PHPMYADMIN_PORT=8082

DOCKER_MYSQL_DATABASE=agrisystem_local
DOCKER_BACKEND_DATABASE=agrisystem_local
DOCKER_MYSQL_USER=agrisystem
DOCKER_MYSQL_PASSWORD=replace-with-a-local-database-password
DOCKER_MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
DOCKER_JWT_SECRET=replace-with-a-long-random-local-secret

# Optional integrations
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
OPENWEATHER_API_KEY=
